{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII educational profile settings and accessibility preferences for a CyberShield user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["senior", "caregiver"] },
        "preferredLanguage": { "type": "string", "minLength": 2, "maxLength": 10, "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "largeText": { "type": "boolean" },
        "speechRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "preferredLanguage", "largeText", "speechRate", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document containing email, optional mobile number, and personal emergency family contact note.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 5, "maxLength": 180 },
        "mobileNumber": { "type": "string", "maxLength": 24 },
        "emergencyContactNote": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "LearningProgress": {
      "title": "LearningProgress",
      "description": "Tracks tutorial completion and voice playback status for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tutorialId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "completed": { "type": "boolean" },
        "voiceListened": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tutorialId", "completed", "voiceListened", "updatedAt"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Stores mini-quiz score after completing a tutorial.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tutorialId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tutorialTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "takenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tutorialId", "tutorialTitle", "score", "totalQuestions", "takenAt"]
    },
    "SimulationResult": {
      "title": "SimulationResult",
      "description": "Records an educational scam simulator practice attempt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scenarioId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "selectedOptionId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isCorrect": { "type": "boolean" },
        "attemptedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "scenarioId", "selectedOptionId", "isCorrect", "attemptedAt"]
    },
    "ScamCheckRecord": {
      "title": "ScamCheckRecord",
      "description": "Optional opted-in scam check summary saved only when explicitly enabled by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "inputType": { "type": "string", "enum": ["sms", "whatsapp", "email", "url", "message"] },
        "contentExcerpt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "riskLevel": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "riskScore": { "type": "integer" },
        "matchedPatterns": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "inputType", "contentExcerpt", "riskLevel", "riskScore", "matchedPatterns", "createdAt"]
    },
    "ConsentInvite": {
      "title": "ConsentInvite",
      "description": "One-time caregiver consent invite generated by a senior citizen.",
      "type": "object",
      "properties": {
        "seniorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "seniorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "caregiverEmail": { "type": "string", "minLength": 5, "maxLength": 180 },
        "status": { "type": "string", "enum": ["pending", "claimed", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seniorUid", "seniorName", "caregiverEmail", "status", "createdAt", "updatedAt"]
    },
    "CaregiverLink": {
      "title": "CaregiverLink",
      "description": "Consent-verified link exposing only educational learning summaries (zero PII) to an authorized caregiver.",
      "type": "object",
      "properties": {
        "seniorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "caregiverUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 16, "pattern": "^[A-Z0-9]+$" },
        "seniorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "caregiverEmail": { "type": "string", "minLength": 5, "maxLength": 180 },
        "status": { "type": "string", "enum": ["granted", "revoked"] },
        "tutorialsCompletedCount": { "type": "integer" },
        "totalTutorials": { "type": "integer" },
        "simTotalAttempts": { "type": "integer" },
        "simCorrectAttempts": { "type": "integer" },
        "simUniqueMastered": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "seniorUid",
        "caregiverUid",
        "inviteCode",
        "seniorName",
        "caregiverEmail",
        "status",
        "tutorialsCompletedCount",
        "totalTutorials",
        "simTotalAttempts",
        "simCorrectAttempts",
        "simUniqueMastered",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User's non-PII profile settings and language preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document accessible strictly to the owning verified user."
    },
    "/users/{userId}/learning_progress/{tutorialId}": {
      "schema": { "$ref": "#/entities/LearningProgress" },
      "description": "Tutorial completion and voice playback state per user."
    },
    "/users/{userId}/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "Tutorial quiz scores owned by the user."
    },
    "/users/{userId}/simulation_results/{attemptId}": {
      "schema": { "$ref": "#/entities/SimulationResult" },
      "description": "Scam simulator practice attempts owned by the user."
    },
    "/users/{userId}/scam_checks/{checkId}": {
      "schema": { "$ref": "#/entities/ScamCheckRecord" },
      "description": "Opted-in scam check history owned strictly by the user."
    },
    "/consent_invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/ConsentInvite" },
      "description": "Senior-issued caregiver invite codes."
    },
    "/caregiver_links/{linkId}": {
      "schema": { "$ref": "#/entities/CaregiverLink" },
      "description": "Consent-gated educational summary shared with an authorized caregiver."
    }
  }
}
